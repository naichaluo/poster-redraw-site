# 复制为 .env 并填写
# 火山方舟 API Key（需要有 Seedream 5.0 Pro 图片生成权限）
ARK_API_KEY=ark-你的Key

# 图片模型（默认 doubao-seedream-5-0-pro-260628）
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628

# 服务端口（默认 3000）
PORT=3000

# 管理后台口令（管理账号/额度用），生产环境务必设置
ADMIN_KEY=请设置一个复杂的口令

# 可选：Ark API 基础地址
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
